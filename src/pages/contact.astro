---
import { SITE_DESCRIPTION } from '../consts';
import SiteLayout from '../layouts/SiteLayout.astro';

const contacts = [
	{ label: 'Email', value: 'nightscratch1145@gmail.com', href: 'mailto:nightscratch1145@gmail.com' },
	{ label: 'QQ', value: '1705755479' },
	{ label: 'Discord', value: 'nights0522' },
	{ label: 'GitHub', value: 'github.com/Nightre', href: 'https://github.com/Nightre' },
	{ label: 'Telegram', value: '@nightscratch2', href: 'https://t.me/nightscratch2' },
	{ label: '微信', value: 'ogel2008' },
	{ label: 'X', value: '@nightscratchSB', href: 'https://x.com/nightscratchSB' },
	{ label: 'RSS', value: 'Subscribe via RSS', href: '/rss.xml' },
];
---

<SiteLayout title="Contact | NightScratch" description={SITE_DESCRIPTION} mainClass="page-shell-narrow">
	<header class="page-heading">
		<h1 data-i18n="contact.title">Contact me</h1>
	</header>

	<section class="pixel-panel">
		<ul class="list-divider m-0 list-none p-0">
			{contacts.map((contact) => (
				<li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
					<span class="font-bold text-ink">{contact.label}</span>
					{contact.href ? (
						<a class="break-all text-left sm:text-right" href={contact.href} target={contact.href.startsWith('http') ? '_blank' : undefined} rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
							{contact.value}
						</a>
					) : (
						<span class="break-all text-muted sm:text-right">{contact.value}</span>
					)}
				</li>
			))}
		</ul>
	</section>
</SiteLayout>
