---
import { getCollection } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getLocalizedPosts, type Locale } from '../../../utils/blog';

const lang = (Astro.params.lang ?? 'en') as Locale;

export function getStaticPaths() {
	return ['en', 'zh', 'ja'].map((locale) => ({ params: { lang: locale } }));
}

const posts = getLocalizedPosts(await getCollection('blog'), lang);
---

<SiteLayout title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} lang={lang}>
	<header class="page-heading">
		<h1 data-i18n="blog.title">Writing</h1>
		<p data-i18n="blog.intro">Notes, experiments, and occasional longer pieces.</p>
	</header>

	<ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-2">
		{posts.map(({ post, slug }) => (
			<li class="first:md:col-span-2">
				<a class="pixel-panel group block h-full !p-3 text-ink no-underline" href={`/${post.data.lang}/blog/${slug}/`}>
					{post.data.heroImage && <img class="aspect-[2/1] w-full rounded-lg object-cover" width="1020" height="510" src={post.data.heroImage} alt="" />}
					<div class="px-2 pb-2 pt-4 sm:px-3">
						<p class="mb-2 mt-0 text-sm text-muted"><FormattedDate date={post.data.pubDate} /></p>
						<h2 class="text-[clamp(1.35rem,3vw,2rem)] transition-colors group-hover:text-accent">{post.data.title}</h2>
					</div>
				</a>
			</li>
		))}
	</ul>
</SiteLayout>
