---
import { SITE_DESCRIPTION } from '../consts';
import galleryItems from '../data/gallery.json';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Gallery | NightScratch" description={SITE_DESCRIPTION}>
	<header class="page-heading">
		<h1 data-i18n="gallery.title">Gallery</h1>
		<p data-i18n="gallery.intro">A collection of things I have drawn.</p>
	</header>

	<section class="columns-1 gap-5 sm:columns-2 lg:columns-3" aria-label="Gallery">
		{galleryItems.map((item) => (
			<figure class="pixel-panel group relative mb-5 break-inside-avoid !p-2 transition-transform duration-200 hover:-translate-y-1 focus-within:-translate-y-1">
				<a class="block cursor-zoom-in overflow-hidden rounded-lg" href={item.image} aria-label={`Open full-size ${item.alt}`}>
					<img class="block h-auto w-full transition-transform duration-300 group-hover:scale-[1.025]" src={item.thumbnail} alt={item.alt} loading="lazy" decoding="async" />
				</a>
				<figcaption class="px-2 pb-1 pt-2 text-sm text-muted">{item.caption}</figcaption>
			</figure>
		))}
	</section>
</SiteLayout>
