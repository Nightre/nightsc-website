---
import { getCollection } from 'astro:content';
import Comments from '../components/Comments.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import SectionHeader from '../components/SectionHeader.astro';
import VisitorRelay from '../components/VisitorRelay.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import galleryItems from '../data/gallery.json';
import { projects } from '../data/projects';
import SiteLayout from '../layouts/SiteLayout.astro';
import * as m from '../paraglide/messages.js';

const allPosts = await getCollection('blog');
const postsBySlug = new Map<string, typeof allPosts>();

for (const post of allPosts) {
	const slug = post.id.split('/').slice(1).join('/');
	const translations = postsBySlug.get(slug) ?? [];
	translations.push(post);
	postsBySlug.set(slug, translations);
}

const recentPosts = [...postsBySlug.entries()]
	.map(([slug, translations]) => {
		const byLanguage = new Map(translations.map((post) => [post.data.lang, post]));
		const fallback = byLanguage.get('en') ?? byLanguage.get('zh') ?? byLanguage.get('ja')!;
		const localizedPost = (language: 'en' | 'zh' | 'ja') => byLanguage.get(language) ?? fallback;

		return {
			slug,
			cover: fallback.data.heroImage,
			latestDate: Math.max(...translations.map((post) => post.data.pubDate.valueOf())),
			titles: {
				en: localizedPost('en').data.title,
				zh: localizedPost('zh').data.title,
				ja: localizedPost('ja').data.title,
			},
			hrefs: {
				en: `/${localizedPost('en').data.lang}/blog/${slug}/`,
				zh: `/${localizedPost('zh').data.lang}/blog/${slug}/`,
				ja: `/${localizedPost('ja').data.lang}/blog/${slug}/`,
			},
		};
	})
	.sort((a, b) => b.latestDate - a.latestDate)
	.slice(0, 5);

const [latestPost, ...olderPosts] = recentPosts;
const recentGallery = galleryItems.slice(0, 2);

const projectDescriptions = {
	rapid: { key: 'project.rapid.description', text: m.project_rapid_description() },
	loopring: { key: 'project.loopring.description', text: m.project_loopring_description() },
	polyrig: { key: 'project.polyrig.description', text: m.project_polyrig_description() },
	axopl: { key: 'project.axopl.description', text: m.project_axopl_description() },
} as const;
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(19rem,0.75fr)]">
		<div class="grid gap-6">
			<section class="pixel-panel grid items-center gap-6 sm:grid-cols-[9rem_minmax(0,1fr)] sm:p-10">
				<img
					class="aspect-square w-28 rounded-xl object-cover sm:w-36"
					src="https://avatars.githubusercontent.com/u/149653910?s=400&u=d200f991b7c1f38b1836a88cf25439d0740581e2&v=4"
					alt="NightScratch"
					width="400"
					height="400"
					decoding="async"
				/>
				<div class="min-w-0">
					<h1 class="text-[2rem]" data-i18n="home.title">Hello, I’m NightScratch.</h1>
					<p class="mb-0 mt-4 max-w-2xl text-lg text-muted" data-i18n="home.intro">
						A small corner for code, ideas, and things worth remembering.
					</p>
				</div>
			</section>

			<section class="pixel-panel" aria-labelledby="recent-posts-title">
				<SectionHeader
					id="recent-posts-title"
					title="Recent articles"
					titleKey="home.recent"
					href="/en/blog"
					localizedHref
				/>
				{latestPost && (
					<a
						class="group block text-ink no-underline"
						href={latestPost.hrefs.en}
						data-localized-post-link
						data-post-slug={latestPost.slug}
						data-title-en={latestPost.titles.en}
						data-title-zh={latestPost.titles.zh}
						data-title-ja={latestPost.titles.ja}
						data-href-en={latestPost.hrefs.en}
						data-href-zh={latestPost.hrefs.zh}
						data-href-ja={latestPost.hrefs.ja}
					>
						{latestPost.cover && (
							<img class="aspect-[2/1] w-full rounded-lg object-cover" src={latestPost.cover} alt="" />
						)}
						<strong class="mt-4 block text-xl transition-colors group-hover:text-accent" data-localized-post-title>
							{latestPost.titles.en}
						</strong>
					</a>
				)}

				{olderPosts.length > 0 && (
					<ul class="list-divider m-0 mt-4 list-none p-0">
					{olderPosts.map(({ slug, titles, hrefs }) => (
						<li>
							<a
								class="block py-3 font-bold text-ink no-underline hover:text-accent"
								href={hrefs.en}
								data-localized-post-link
								data-post-slug={slug}
								data-title-en={titles.en}
								data-title-zh={titles.zh}
								data-title-ja={titles.ja}
								data-href-en={hrefs.en}
								data-href-zh={hrefs.zh}
								data-href-ja={hrefs.ja}
							>
								<span data-localized-post-title>{titles.en}</span>
							</a>
						</li>
					))}
					</ul>
				)}
			</section>

			<VisitorRelay />
		</div>

		<aside class="grid gap-6 lg:sticky lg:top-5">
			<section class="pixel-panel" aria-labelledby="projects-title">
				<h2 class="mb-4" id="projects-title" data-i18n="home.projects">Projects</h2>
				<ul class="m-0 list-none p-0">
					{projects.map((project, index) => {
						const description = projectDescriptions[project.id];
						return (
							<li>
								<a class="group flex min-w-0 items-center gap-3 py-3 text-ink no-underline" href={project.href} target="_blank" rel="noopener noreferrer">
									<img class="size-14 shrink-0 rounded-lg bg-white object-cover" src={project.cover} width="64" height="64" alt="" />
									<span class="min-w-0 flex-1">
										<strong class="block truncate transition-colors group-hover:text-accent">{project.name}</strong>
										<span class="mt-0.5 block text-sm leading-5 text-muted transition-colors group-hover:text-accent" data-i18n={description.key}>{description.text}</span>
									</span>
								</a>
								{index < projects.length - 1 && <hr class="my-0 border-0 border-t border-ink/15" />}
							</li>
						);
					})}
				</ul>
			</section>

			<section class="pixel-panel" aria-labelledby="recent-gallery-title">
				<SectionHeader
					id="recent-gallery-title"
					title="Recent gallery"
					titleKey="home.gallery"
					href="/gallery"
				/>
				<div class="gap-4 flex flex-col">
					{recentGallery.map((item) => (
						<a class="block overflow-hidden rounded-lg bg-white" href={item.image} aria-label={`Open full-size ${item.alt}`}>
							<img class="aspect-[4/3] w-full object-cover transition-transform duration-200" src={item.thumbnail} alt={item.alt} loading="lazy" decoding="async" />
						</a>
					))}
				</div>
			</section>
		</aside>
	</div>

	<NewsletterSignup />
	<Comments postId="home" />
</SiteLayout>
