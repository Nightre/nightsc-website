---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import Comments from "../components/Comments.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import * as m from "../paraglide/messages.js";

const allPosts = await getCollection("blog");
const postsBySlug = new Map<string, typeof allPosts>();

for (const post of allPosts) {
	const slug = post.id.split('/').slice(1).join('/');
	const translations = postsBySlug.get(slug) ?? [];
	translations.push(post);
	postsBySlug.set(slug, translations);
}

const recentPosts = [...postsBySlug.entries()]
	.map(([slug, translations]) => {
		const byLanguage = new Map(translations.map((post) => [post.data.lang, post]));
		const fallbackPost = byLanguage.get('en') ?? byLanguage.get('zh') ?? byLanguage.get('ja')!;
		const localizedPost = (language: 'en' | 'zh' | 'ja') => byLanguage.get(language) ?? fallbackPost;
		return {
			post: fallbackPost,
			slug,
			latestDate: Math.max(...translations.map((post) => post.data.pubDate.valueOf())),
			titles: {
				en: localizedPost('en').data.title,
				zh: localizedPost('zh').data.title,
				ja: localizedPost('ja').data.title,
			},
			hrefs: {
				en: `/${localizedPost('en').data.lang}/blog/${slug}/`,
				zh: `/${localizedPost('zh').data.lang}/blog/${slug}/`,
				ja: `/${localizedPost('ja').data.lang}/blog/${slug}/`,
			},
		};
	})
	.sort((a, b) => b.latestDate - a.latestDate)
	.slice(0, 5);

const projects = [
	{
		name: "Rapid.js",
		descriptionKey: "project.rapid.description",
		description: m.project_rapid_description(),
		href: "https://nightre.github.io/Rapid.js/",
		cover: "https://raw.githubusercontent.com/Nightre/Rapid.js/refs/heads/main/docs/image/logo.png",
	},
	{
		name: "LoopRing",
		descriptionKey: "project.loopring.description",
		description: m.project_loopring_description(),
		href: "https://nightsnever.itch.io/loop",
		cover: "https://img.itch.zone/aW1nLzIyNTgwMTc2LnBuZw==/315x250%23c/AaEDAG.png",
	},
	{
		name: "Polyrig",
		descriptionKey: "project.polyrig.description",
		description: m.project_polyrig_description(),
		href: "https://nightscratch1.itch.io/polyrig",
		cover: "https://img.itch.zone/aW1hZ2UvNDI4NjU0MS8yNTU2MTY1Ni5wbmc=/347x500/MQBmdK.png",
	},
	{
		name: "Axopl",
		descriptionKey: "project.axopl.description",
		description: m.project_axopl_description(),
		href: "https://axopl.com/",
		cover: "https://axopl.com/assets/logo-by-bob-Dc3AxB_x.svg",
	},
];
---

<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<div class="home-grid">
				<div class="home-column">
					<section class="intro-card">
						<div class="intro-avatar-wrap">
							<img
								class="intro-avatar"
								src="https://avatars.githubusercontent.com/u/149653910?s=400&u=d200f991b7c1f38b1836a88cf25439d0740581e2&v=4"
								alt="NightScratch"
								width="400"
								height="400"
								decoding="async"
							/>
						</div>
						<div class="intro-copy">
							<h4 data-i18n="home.title">Hello, I’m NightScratch.</h4>
							<p class="intro" data-i18n="home.intro">
								A small corner for code, ideas, and things worth
								remembering.
							</p>
						</div>
					</section>
					<section
						class="recent-posts"
						aria-labelledby="recent-posts-title"
					>
						<h2 id="recent-posts-title" data-i18n="home.recent">
							Recent articles
						</h2>
						<ul>
							{
								recentPosts.map(({ post, slug, titles, hrefs }) => (
									<li>
										<a
											href={hrefs.en}
											data-localized-post-link
											data-post-slug={slug}
											data-title-en={titles.en}
											data-title-zh={titles.zh}
											data-title-ja={titles.ja}
											data-href-en={hrefs.en}
											data-href-zh={hrefs.zh}
											data-href-ja={hrefs.ja}
										>
											{post.data.title}
										</a>
									</li>
								))
							}
						</ul>
					</section>
				</div>
				<section class="projects-card" aria-labelledby="projects-title">
					<h2 id="projects-title" data-i18n="home.projects">
						Projects
					</h2>
					<ul>
						{
							projects.map((project) => (
								<li>
									<a
										class="project-link"
										href={project.href}
										target="_blank"
										rel="noopener noreferrer"
									>
										<img
											class="project-cover"
											src={project.cover}
											width="64"
											height="64"
											alt=""
										/>
										<span class="project-copy">
											<strong>{project.name}</strong>
											<span class="project-description" data-i18n={project.descriptionKey}>
												{project.description}
											</span>
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</section>
			</div>
			<NewsletterSignup />
			<Comments postId="home" />
		</main>
		<Footer />
	</body>
</html>
