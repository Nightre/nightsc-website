---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Comments from '../components/Comments.astro';

type Props = CollectionEntry<'blog'>['data'] & { translationKey?: string; postId?: string; lang?: string };

const { title, description, pubDate, updatedDate, heroImage, translationKey, postId, lang = 'en' } = Astro.props;
---

<html lang={lang} transition:animate="none">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 1020px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
			}
			.prose {
				width: 100%;
				max-width: none;
				box-sizing: border-box;
				margin: 2rem auto 0;
				padding: 2em;
				border: 8px solid transparent;
				border-image-source: var(--frame-card);
				border-image-slice: 16 fill;
				border-image-width: 16px;
				border-image-repeat: repeat;
				image-rendering: pixelated;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.author{
				color:rgb(var(--gray));;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
									<span data-i18n="post.updated">Last updated on</span>{' '}
									<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1 data-i18n={translationKey}>{title}</h1>
						<p class="author">By Nightscratch</p>
						<hr />
					</div>
					<slot />
				</div>
			</article>
			{postId && <Comments postId={postId} />}
		</main>
		<Footer />
	</body>
</html>
