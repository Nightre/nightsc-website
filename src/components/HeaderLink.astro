---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizePath = (value: string) => {
	const normalized = `/${value.replace(import.meta.env.BASE_URL, '').replace(/^\/+|\/+$/g, '')}`;
	return normalized === '/' ? normalized : normalized.replace(/\/+$/, '');
};
const pathname = normalizePath(Astro.url.pathname);
const linkPath = normalizePath(typeof href === 'string' ? href : '/');
const isActive = linkPath === '/'
	? pathname === '/'
	: pathname === linkPath || pathname.startsWith(`${linkPath}/`);
---

<a href={href} class:list={['nav-link', className, { active: isActive }]} {...props}>
	<slot />
</a>
