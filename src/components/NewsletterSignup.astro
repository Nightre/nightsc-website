---
import emailIcon from '../styles/icons/email.png';
---

<section class="pixel-panel mt-6 grid items-center gap-8 lg:grid-cols-[1fr_minmax(20rem,0.9fr)] lg:gap-12" aria-labelledby="newsletter-title">
	<div>
		<div class="mb-2 flex items-center gap-2">
			<img class="pixel-icon" src={emailIcon.src} width="64" height="64" alt="" />
			<p class="eyebrow mb-0" data-i18n="newsletter.eyebrow">Email newsletter</p>
		</div>
		<h2 id="newsletter-title" data-i18n="newsletter.title">New posts, sent quietly.</h2>
		<p class="mb-0 mt-3 max-w-xl text-base text-muted" data-i18n="newsletter.body">
			Get an email when something new is published. No noise, unsubscribe anytime.
		</p>
	</div>

	<form data-newsletter-form>
		<label class="sr-only" for="newsletter-email">Email address</label>
		<div class="flex flex-col gap-2 sm:flex-row">
			<input
				class="pixel-input h-14"
				id="newsletter-email"
				name="email"
				type="email"
				autocomplete="email"
				inputmode="email"
				placeholder="you@example.com"
				data-i18n-placeholder="newsletter.placeholder"
				required
			/>
			<button class="pixel-button shrink-0" type="submit" data-i18n="newsletter.button">Subscribe</button>
		</div>
		<label class="sr-only" aria-hidden="true">
			Website
			<input name="website" type="text" tabindex="-1" autocomplete="off" />
		</label>
		<p class="mb-0 mt-2 min-h-6 text-sm text-muted" data-newsletter-status role="status" aria-live="polite"></p>
	</form>
</section>

<script>
	function refreshTranslations() {
		document.dispatchEvent(new CustomEvent('site:refresh-language'));
	}

	function initializeNewsletterForm() {
		const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
		if (!form || form.dataset.newsletterReady === 'true') return;

		form.dataset.newsletterReady = 'true';
		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			const email = form.elements.namedItem('email') as HTMLInputElement;
			const website = form.elements.namedItem('website') as HTMLInputElement;
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const status = form.querySelector<HTMLElement>('[data-newsletter-status]');
			if (!button || !status) return;

			if (!email.validity.valid) {
				status.dataset.i18n = 'newsletter.invalid';
				refreshTranslations();
				email.focus();
				return;
			}

			button.disabled = true;
			button.dataset.i18n = 'newsletter.sending';
			status.textContent = '';
			refreshTranslations();

			try {
				const response = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email: email.value, website: website.value }),
				});
				const result = await response.json() as { code?: string };
				const allowedCodes = ['success', 'exists', 'invalid'] as const;
				const code = allowedCodes.includes(result.code as (typeof allowedCodes)[number])
					? result.code
					: 'error';

				status.dataset.i18n = `newsletter.${code}`;
				if (response.ok) form.reset();
			} catch {
				status.dataset.i18n = 'newsletter.error';
			} finally {
				button.disabled = false;
				button.dataset.i18n = 'newsletter.button';
				refreshTranslations();
			}
		});
	}

	initializeNewsletterForm();
	document.addEventListener('astro:page-load', initializeNewsletterForm);
</script>
