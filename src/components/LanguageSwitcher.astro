---
import langIcon from '../styles/icons/lang.png';
---

<div class="language-picker">
	<label class="sr-only" for="site-language" data-i18n="language.label">Language</label>
	<img class="language-icon" src={langIcon.src} width="64" height="64" alt="" />
	<select id="site-language" aria-label="Language" data-language-select>
		<option value="en">EN</option>
		<option value="zh">中文</option>
		<option value="ja">日本語</option>
	</select>
</div>

<script>
	import * as m from '../paraglide/messages.js';
	import { getLocale, setLocale } from '../paraglide/runtime.js';

	const messageByKey = {
		'language.label': m.language_label,
		'font.pixel': m.font_pixel,
		'nav.home': m.nav_home,
		'nav.blog': m.nav_blog,
		'nav.gallery': m.nav_gallery,
		'nav.contact': m.nav_contact,
		'nav.rss': m.nav_rss,
		'home.eyebrow': m.home_eyebrow,
		'home.title': m.home_title,
		'home.intro': m.home_intro,
		'home.recent': m.home_recent,
		'home.projects': m.home_projects,
		'project.rapid.description': m.project_rapid_description,
		'project.loopring.description': m.project_loopring_description,
		'project.polyrig.description': m.project_polyrig_description,
		'project.axopl.description': m.project_axopl_description,
		'newsletter.eyebrow': m.newsletter_eyebrow,
		'newsletter.title': m.newsletter_title,
		'newsletter.body': m.newsletter_body,
		'newsletter.placeholder': m.newsletter_placeholder,
		'newsletter.button': m.newsletter_button,
		'newsletter.sending': m.newsletter_sending,
		'newsletter.success': m.newsletter_success,
		'newsletter.exists': m.newsletter_exists,
		'newsletter.invalid': m.newsletter_invalid,
		'newsletter.error': m.newsletter_error,
		'blog.title': m.blog_title,
		'blog.intro': m.blog_intro,
		'post.updated': m.post_updated,
		'comments.title': m.comments_title,
		'comments.name': m.comments_name,
		'comments.namePlaceholder': m.comments_name_placeholder,
		'comments.content': m.comments_content,
		'comments.contentPlaceholder': m.comments_content_placeholder,
		'comments.submit': m.comments_submit,
		'comments.submitting': m.comments_submitting,
		'comments.loading': m.comments_loading,
		'comments.empty': m.comments_empty,
		'comments.success': m.comments_success,
		'comments.error': m.comments_error,
		'comments.rateLimited': m.comments_rate_limited,
		'gallery.title': m.gallery_title,
		'gallery.intro': m.gallery_intro,
		'contact.title': m.contact_title,
		'footer.rights': m.footer_rights,
		'footer.x': m.footer_x,
		'footer.github': m.footer_github,
	} as const;

	type Locale = 'en' | 'zh' | 'ja';
	type MessageKey = keyof typeof messageByKey;
	const supportedLocales: Locale[] = ['en', 'zh', 'ja'];

	function getBlogRouteLocale(): Locale | undefined {
		const locale = window.location.pathname.match(/^\/(en|zh|ja)\/blog(?:\/|$)/)?.[1];
		return supportedLocales.includes(locale as Locale) ? locale as Locale : undefined;
	}

	function renderLanguage(locale: Locale) {
		document.documentElement.lang = locale === 'zh' ? 'zh-CN' : locale;
		document.querySelectorAll('[data-i18n]').forEach((element) => {
			const translatedElement = element as unknown as HTMLElement;
			const message = messageByKey[translatedElement.dataset.i18n as MessageKey];
			if (message) translatedElement.textContent = message();
		});
		document.querySelectorAll('[data-i18n-aria-label]').forEach((element) => {
			const translatedElement = element as unknown as HTMLElement;
			const message = messageByKey[translatedElement.dataset.i18nAriaLabel as MessageKey];
			if (message) {
				const text = message();
				translatedElement.setAttribute('aria-label', text);
				translatedElement.setAttribute('title', text);
			}
		});
		document.querySelectorAll('[data-i18n-placeholder]').forEach((element) => {
			const input = element as unknown as HTMLInputElement;
			const message = messageByKey[input.dataset.i18nPlaceholder as MessageKey];
			if (message) input.placeholder = message();
		});
		document.querySelectorAll('[data-language-select]').forEach((element) => {
			const select = element as unknown as HTMLSelectElement;
			select.value = locale;
		});
		document.querySelectorAll('[data-localized-blog-link]').forEach((element) => {
			const link = element as unknown as HTMLAnchorElement;
			link.href = `/${locale}/blog`;
		});
		document.querySelectorAll('[data-localized-post-link]').forEach((element) => {
			const link = element as unknown as HTMLAnchorElement;
			const slug = link.dataset.postSlug;
			const title = link.getAttribute(`data-title-${locale}`);
			if (slug) link.href = `/${locale}/blog/${slug}/`;
			if (title) link.textContent = title;
		});
		delete document.documentElement.dataset.i18nPending;
		document.dispatchEvent(new CustomEvent('site:language-change', { detail: { locale } }));
	}

	async function initializeLanguageSwitcher() {
		const routeLocale = getBlogRouteLocale();
		if (routeLocale && routeLocale !== getLocale()) {
			await setLocale(routeLocale, { reload: false });
		}
		renderLanguage(routeLocale ?? getLocale() as Locale);
		document.querySelectorAll('[data-language-select]').forEach((element) => {
			const select = element as unknown as HTMLSelectElement;
			if (select.dataset.languageReady === 'true') return;
			select.dataset.languageReady = 'true';
			select.addEventListener('change', async () => {
				const locale = select.value as Locale;
				await setLocale(locale, { reload: false });
				const localizedBlogPath = window.location.pathname.match(/^\/(en|zh|ja)(\/blog(?:\/.*)?)\/?$/);
				if (localizedBlogPath) {
					window.location.assign(`/${locale}${localizedBlogPath[2]}`);
					return;
				}
				renderLanguage(locale);
			});
		});
	}

	void initializeLanguageSwitcher();
	document.addEventListener('astro:page-load', () => void initializeLanguageSwitcher());
	document.addEventListener('site:refresh-language', () => renderLanguage(getLocale() as Locale));
</script>

<style>
	.language-picker {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		height: 100%;
		color: rgb(var(--gray-dark));
		font-size: 0.8rem;
	}
	.language-icon {
		display: block;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 0;
		image-rendering: crisp-edges;
		image-rendering: pixelated;
	}
	select {
		width: 6.5rem;
		min-height: 3rem;
		box-sizing: border-box;
		padding: 0 1.25rem 0 0.25rem;
		border: 8px solid transparent;
		border-image-source: var(--frame-input);
		border-image-slice: 16 fill;
		border-image-width: 16px;
		border-image-repeat: repeat;
		image-rendering: pixelated;
		background: transparent;
		color: rgb(var(--black));
		font: inherit;
		cursor: pointer;
	}
	select:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--accent) 30%, transparent);
		outline-offset: 2px;
	}
	@media (max-width: 720px) {
		.language-picker span { display: none; }
		select { width: 6rem; }
	}
</style>
