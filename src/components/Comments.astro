---
interface Props {
	postId: string;
}

import avatar from "../styles/avatar.png";

const { postId } = Astro.props;
---

<section
	class="pixel-panel mt-8"
	data-comments-root
	data-post-id={postId}
	data-avatar-src={avatar.src}
	aria-labelledby="comments-title"
>
	<h2 class="mb-5" id="comments-title" data-i18n="comments.title">Comments</h2>
	<form class="grid gap-4" data-comment-form>
		<label class="grid gap-1.5 font-bold">
			<span data-i18n="comments.name">Name</span>
			<input
				class="pixel-input min-h-14 font-normal"
				name="name"
				type="text"
				maxlength="40"
				autocomplete="name"
				placeholder="Your name"
				data-i18n-placeholder="comments.namePlaceholder"
				required
			/>
		</label>
		<label class="grid gap-1.5 font-bold">
			<span data-i18n="comments.content">Comment</span>
			<textarea
				class="pixel-input min-h-36 resize-y py-3 font-normal"
				name="content"
				rows="5"
				maxlength="2000"
				placeholder="Write a comment…"
				data-i18n-placeholder="comments.contentPlaceholder"
				required></textarea>
		</label>
		<label class="sr-only" aria-hidden="true">
			Website
			<input
				name="website"
				type="text"
				tabindex="-1"
				autocomplete="off"
			/>
		</label>
		<div class="flex flex-col items-stretch justify-between gap-3 sm:flex-row sm:items-center">
			<p
				class="m-0 min-h-6 text-sm text-muted"
				data-comment-status
				role="status"
				aria-live="polite"
			>
			</p>
			<button class="pixel-button w-full sm:w-auto" type="submit" data-i18n="comments.submit"
				>Post comment</button
			>
		</div>
	</form>
	<div class="mt-8 grid" data-comment-list aria-live="polite">
		<p class="m-0 text-muted" data-i18n="comments.loading">Loading comments…</p>
	</div>
</section>

<script>
	const commentNameStorageKey = "COMMENT_AUTHOR_NAME";

	function createDefaultCommentName() {
		const randomBytes = new Uint8Array(2);
		crypto.getRandomValues(randomBytes);
		const suffix = Array.from(randomBytes, (value) =>
			value.toString(16).padStart(2, "0"),
		).join("").toUpperCase();
		return `Guest-${suffix}`;
	}

	type CommentItem = {
		id: string;
		name: string;
		content: string;
		createdAt: string;
	};

	function formatCommentDates() {
		const locale = document.documentElement.lang || "en";
		const formatter = new Intl.RelativeTimeFormat(locale, {
			numeric: "always",
		});
		const brackets =
			locale.startsWith("zh") || locale === "ja"
				? ["（", "）"]
				: ["(", ")"];
		document
			.querySelectorAll<HTMLTimeElement>("[data-comment-time]")
			.forEach((time) => {
				if (!time.dateTime) return;
				const diff = new Date(time.dateTime).getTime() - Date.now();
				const absoluteSeconds = Math.abs(diff) / 1000;
				const units: Array<[Intl.RelativeTimeFormatUnit, number]> = [
					["year", 31536000],
					["month", 2592000],
					["day", 86400],
					["hour", 3600],
					["minute", 60],
					["second", 1],
				];
				const [unit, size] = units.find(
					([, seconds]) => absoluteSeconds >= seconds,
				) ?? ["second", 1];
				time.textContent = `${brackets[0]}${formatter.format(Math.round(diff / 1000 / size), unit)}${brackets[1]}`;
			});
	}

	function requestTranslationRefresh() {
		document.dispatchEvent(new CustomEvent("site:refresh-language"));
	}

	function renderComments(root: HTMLElement, comments: CommentItem[]) {
		const container = root.querySelector<HTMLElement>(
			"[data-comment-list]",
		);
		if (!container) return;
		container.replaceChildren();
		if (!comments.length) {
			const empty = document.createElement("p");
			empty.dataset.i18n = "comments.empty";
			container.append(empty);
			requestTranslationRefresh();
			return;
		}

		for (const comment of comments) {
			const article = document.createElement("article");
			article.className = "comment-item";
			const header = document.createElement("header");
			const avatar = document.createElement("img");
			avatar.className = "comment-avatar";
			avatar.src = root.dataset.avatarSrc ?? "";
			avatar.alt = "";
			const author = document.createElement("strong");
			author.textContent = comment.name;
			const time = document.createElement("time");
			time.dateTime = comment.createdAt;
			time.dataset.commentTime = "";
			const content = document.createElement("p");
			content.textContent = comment.content;
			header.append(author, time);
			const body = document.createElement("div");
			body.className = "comment-body";
			body.append(header, content);
			article.append(avatar, body);
			container.append(article);
		}
		formatCommentDates();
	}

	async function loadComments(root: HTMLElement) {
		const list = root.querySelector<HTMLElement>("[data-comment-list]");
		if (!list) return;
		try {
			const response = await fetch(
				`/api/comments?postId=${encodeURIComponent(root.dataset.postId ?? "")}`,
			);
			if (!response.ok) throw new Error("Could not load comments");
			const result = (await response.json()) as {
				comments?: CommentItem[];
			};
			renderComments(root, result.comments ?? []);
		} catch {
			list.replaceChildren();
			const error = document.createElement("p");
			error.dataset.i18n = "comments.error";
			list.append(error);
			requestTranslationRefresh();
		}
	}

	function initializeComments() {
		document
			.querySelectorAll<HTMLElement>("[data-comments-root]")
			.forEach((root) => {
				if (root.dataset.commentsReady === "true") return;
				root.dataset.commentsReady = "true";
				const form = root.querySelector<HTMLFormElement>(
					"[data-comment-form]",
				);
				const status = root.querySelector<HTMLElement>(
					"[data-comment-status]",
				);
				const button = form?.querySelector<HTMLButtonElement>(
					'button[type="submit"]',
				);
				const nameInput = form?.querySelector<HTMLInputElement>('input[name="name"]');
				const contentInput = form?.querySelector<HTMLTextAreaElement>('textarea[name="content"]');
				const websiteInput = form?.querySelector<HTMLInputElement>('input[name="website"]');
				if (!form || !status || !button || !nameInput || !contentInput) return;

				try {
					let savedName = localStorage.getItem(commentNameStorageKey)?.trim();
					if (!savedName) {
						savedName = createDefaultCommentName();
						localStorage.setItem(commentNameStorageKey, savedName);
					}
					nameInput.value = savedName;
				} catch {
					nameInput.value = createDefaultCommentName();
				}
				nameInput.addEventListener("input", () => {
					try {
						localStorage.setItem(commentNameStorageKey, nameInput.value);
					} catch {
						// Ignore browsers that block localStorage.
					}
				});

				form.addEventListener("submit", async (event) => {
					event.preventDefault();
					if (!form.reportValidity()) return;
					try {
						localStorage.setItem(commentNameStorageKey, nameInput.value.trim());
					} catch {
						// Ignore browsers that block localStorage.
					}
					button.disabled = true;
					button.dataset.i18n = "comments.submitting";
					status.textContent = "";
					requestTranslationRefresh();
					const data = new FormData(form);
					try {
						const response = await fetch("/api/comments", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({
								postId: root.dataset.postId,
								name: data.get("name"),
								content: data.get("content"),
								website: data.get("website"),
							}),
						});
						if (!response.ok)
						{
							const result = (await response.json().catch(() => null)) as {
								code?: string;
							} | null;
							if (response.status === 429 || result?.code === "rate_limited") {
								status.dataset.i18n = "comments.rateLimited";
								requestTranslationRefresh();
								return;
							}
							throw new Error("Could not post comment");
						}
						contentInput.value = "";
						if (websiteInput) websiteInput.value = "";
						status.dataset.i18n = "comments.success";
						await loadComments(root);
					} catch {
						status.dataset.i18n = "comments.error";
					} finally {
						button.disabled = false;
						button.dataset.i18n = "comments.submit";
						requestTranslationRefresh();
					}
				});
				void loadComments(root);
			});
	}

	initializeComments();
	document.addEventListener("astro:page-load", initializeComments);
	document.addEventListener("site:language-change", formatCommentDates);
</script>
