---
import xIcon from '../styles/icons/x.png';
import githubIcon from '../styles/icons/github.png';

const today = new Date();
---

<footer class="pixel-footer mt-12 px-4 pb-20 pt-10 text-center text-base text-muted">
	<p class="m-0">&copy; {today.getFullYear()} NightScratch. <span data-i18n="footer.rights">All rights reserved.</span></p>
	<div class="mt-4 flex justify-center gap-4">
		<a href="https://x.com/nightscratchSB" target="_blank" rel="noopener noreferrer">
			<span class="sr-only" data-i18n="footer.x">Follow on X</span>
			<img class="pixel-icon" src={xIcon.src} width="64" height="64" alt="" />
		</a>
		<a href="https://github.com/Nightre" target="_blank" rel="noopener noreferrer">
			<span class="sr-only" data-i18n="footer.github">Go to GitHub</span>
			<img class="pixel-icon" src={githubIcon.src} width="64" height="64" alt="" />
		</a>
	</div>
</footer>
