---
import checkboxOff from '../styles/checkbox-off.png';
import checkboxOn from '../styles/checkbox-on.png';
---

<label class="inline-flex cursor-pointer select-none items-center gap-1 text-sm text-ink">
	<input class="peer sr-only" type="checkbox" data-pixel-font-toggle checked />
	<img class="pixel-icon peer-checked:hidden" src={checkboxOff.src} width="64" height="64" alt="" />
	<img class="pixel-icon hidden peer-checked:block" src={checkboxOn.src} width="64" height="64" alt="" />
	<span class="hidden min-[760px]:inline" data-i18n="font.pixel">Pixel font</span>
</label>

<script>
	const pixelFontStorageKey = 'PIXEL_FONT_ENABLED';

	function applyPixelFontPreference(enabled: boolean) {
		document.documentElement.dataset.pixelFont = enabled ? 'on' : 'off';
		document.querySelectorAll('[data-pixel-font-toggle]').forEach((element) => {
			const checkbox = element as unknown as HTMLInputElement;
			checkbox.checked = enabled;
		});
	}

	function initializePixelFontToggle() {
		applyPixelFontPreference(localStorage.getItem(pixelFontStorageKey) !== 'false');
		document.querySelectorAll('[data-pixel-font-toggle]').forEach((element) => {
			const checkbox = element as unknown as HTMLInputElement;
			if (checkbox.dataset.pixelFontReady === 'true') return;
			checkbox.dataset.pixelFontReady = 'true';
			checkbox.addEventListener('change', () => {
				localStorage.setItem(pixelFontStorageKey, String(checkbox.checked));
				applyPixelFontPreference(checkbox.checked);
			});
		});
	}

	initializePixelFontToggle();
	document.addEventListener('astro:page-load', initializePixelFontToggle);
</script>
