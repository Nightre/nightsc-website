---
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import PixelFontToggle from './PixelFontToggle.astro';
import { SITE_TITLE } from '../consts';
import homeIcon from '../styles/icons/home.png';
import blogIcon from '../styles/icons/blog.png';
import galleryIcon from '../styles/icons/hualang.png';
import contactIcon from '../styles/icons/lianxi.png';
import rssIcon from '../styles/icons/rss.png';

const currentLocale = Astro.url.pathname.match(/^\/(en|zh|ja)(?:\/|$)/)?.[1] ?? 'en';
---

<header class="px-2 pt-2 sm:px-5 sm:pt-4">
	<nav class="pixel-nav mx-auto grid max-w-6xl grid-cols-[1fr_auto] items-center gap-x-3 px-2 pt-2 md:grid-cols-[minmax(8rem,1fr)_auto_minmax(12rem,1fr)] md:gap-x-6 md:px-4 md:pt-0" aria-label="Primary navigation">
		<a class="justify-self-start text-lg font-bold text-ink no-underline hover:text-accent" href="/">{SITE_TITLE}</a>

		<div class="col-span-2 row-start-2 flex min-h-14 items-stretch justify-between md:col-span-1 md:col-start-2 md:row-start-1 md:min-h-16">
			<HeaderLink href="/">
				<img class="pixel-icon" src={homeIcon.src} width="64" height="64" alt="" />
				<span class="hidden min-[520px]:inline" data-i18n="nav.home">Home</span>
			</HeaderLink>
			<HeaderLink href={`/${currentLocale}/blog`} data-localized-blog-link>
				<img class="pixel-icon" src={blogIcon.src} width="64" height="64" alt="" />
				<span class="hidden min-[520px]:inline" data-i18n="nav.blog">Blog</span>
			</HeaderLink>
			<HeaderLink href="/gallery">
				<img class="pixel-icon" src={galleryIcon.src} width="64" height="64" alt="" />
				<span class="hidden min-[520px]:inline" data-i18n="nav.gallery">Gallery</span>
			</HeaderLink>
			<HeaderLink href="/contact">
				<img class="pixel-icon" src={contactIcon.src} width="64" height="64" alt="" />
				<span class="hidden min-[520px]:inline" data-i18n="nav.contact">Contact</span>
			</HeaderLink>
			<a
				class="nav-link"
				href="/rss.xml"
				aria-label="Subscribe via RSS"
				title="Subscribe via RSS"
				data-i18n-aria-label="nav.rss"
			>
				<img class="pixel-icon" src={rssIcon.src} width="64" height="64" alt="" />
				<span class="hidden min-[520px]:inline">RSS</span>
			</a>
		</div>

		<div class="flex items-center justify-self-end gap-1 sm:gap-2">
			<LanguageSwitcher />
			<PixelFontToggle />
		</div>
	</nav>
</header>
